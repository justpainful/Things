# Authored on Windows, built on macOS and Ubuntu runners.
# A file that reaches bash with CRLF fails in ways that look nothing like the real cause
# (`\r: command not found`, or a shebang that silently isn't one), so normalise explicitly.

* text=auto eol=lf

# Anything the CI shell executes or parses MUST be LF.
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.swift       text eol=lf
*.ts          text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.pbxproj     text eol=lf
Package.swift text eol=lf

# Windows-only helpers stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ipa  binary
*.zip  binary
*.icns binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
